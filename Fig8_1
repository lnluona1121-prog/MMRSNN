%% =====================================
% Kuramoto 同步序参数
data_phase = x(:,1000:t_sim+1);

N = total_nodes;

phase = zeros(N,size(data_phase,2));

for i = 1:N

    signal = data_phase(i,:);

    analytic_signal = hilbert(signal);

    phase(i,:) = angle(analytic_signal);

end

% 同步矩阵
sync_matrix=zeros(N,N);

for i=1:N

    for j=1:N

        delta_phase = phase(i,:)-phase(j,:);

        sync_matrix(i,j)=...
            abs(mean(exp(1i*delta_phase)));

    end

end


